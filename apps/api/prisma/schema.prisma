generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  phone            String    @unique
  fullName         String?
  role             UserRole  @default(CLIENT)
  languagePref     String    @default("hi")
  pushToken        String?
  referralCode     String    @unique @default(uuid())
  referredBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  version          Int       @default(1)
  email            String?   @unique
  addresses        Address[]
  clientBookings   Booking[] @relation("ClientBookings")
  providerBookings Booking[] @relation("ProviderBookings")
  cart             Cart?
  profile          Profile?

  @@map("users")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  items     Json       @default("[]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String
  serviceId     String
  type          String   // 'regular' or 'hourly'
  title         String
  quantity      Int      @default(1)
  price         Decimal
  bookingType   String   // 'instant' or 'scheduled'
  scheduledAt   DateTime?
  duration      Json?    // For hourly services: { id, label, price, oldPrice, saveAmount }
  schedule      Json?    // For scheduled bookings: { dateId, dateLabel, dayLabel, dateISO, time }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([serviceId])
  @@index([bookingType])
  @@map("cart_items")
}

model Address {
  id           String    @id @default(uuid())
  userId       String
  label        String    @default("Home")
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean   @default(false)
  offlineId    String?   @unique
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@map("addresses")
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  avatarUrl    String?
  bio          Json?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  rating       Float    @default(0.0)
  isVerified   Boolean  @default(false)
  availability Json?
  version      Int      @default(1)
  lastModified DateTime @updatedAt
  country      String?
  documents    Json?
  professionId String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Category {
  id               String        @id @default(uuid())
  nameTranslations Json
  slug             String        @unique
  iconUrl          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            Int           @default(0)
  services         Service[]
  subcategories    Subcategory[]

  @@map("categories")
}

model Subcategory {
  id               String    @id @default(uuid())
  categoryId       String
  nameTranslations Json
  slug             String
  iconUrl          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  services         Service[]
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("subcategories")
}

model Service {
  id                      String       @id @default(uuid())
  categoryId              String
  nameTranslations        Json
  descriptionTranslations Json
  basePrice               Decimal
  imageUrl                String?
  status                  String       @default("ACTIVE")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  subcategoryId           String?
  estimatedTime           String?
  bookings                Booking[]
  category                Category     @relation(fields: [categoryId], references: [id])
  subcategory             Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([categoryId, subcategoryId])
  @@map("services")
}

model Booking {
  id          String        @id @default(uuid())
  clientId    String
  providerId  String?
  serviceId   String
  addressId   String?
  scheduledAt DateTime
  status      BookingStatus @default(PENDING)
  totalPrice  Decimal
  items       Json?
  offlineId   String?       @unique
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  otp         String?
  address     Address?      @relation(fields: [addressId], references: [id])
  client      User          @relation("ClientBookings", fields: [clientId], references: [id])
  provider    User?         @relation("ProviderBookings", fields: [providerId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])
  chats       Chat[]
  payment     Payment?
  review      Review?

  @@map("bookings")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  amount            Decimal
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  escrowStatus      EscrowStatus  @default(HELD)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Chat {
  id         String    @id @default(uuid())
  bookingId  String
  clientId   String
  providerId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  offlineId  String?   @unique
  version    Int       @default(1)
  booking    Booking   @relation(fields: [bookingId], references: [id])
  messages   Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offlineId String?  @unique
  version   Int      @default(1)
  chat      Chat     @relation(fields: [chatId], references: [id])

  @@map("messages")
}

model SupportedCity {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  aliases   String[] @default([])
  latitude  Float
  longitude Float
  radiusKm  Float    @default(50)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("supported_cities")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}
